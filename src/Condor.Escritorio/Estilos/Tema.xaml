<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta: sobria y de alto contraste para el mostrador. -->
    <SolidColorBrush x:Key="FondoVentana" Color="#F5F5F5" />
    <SolidColorBrush x:Key="FondoCabecera" Color="#E3E3E3" />
    <SolidColorBrush x:Key="Borde" Color="#7A7A7A" />
    <SolidColorBrush x:Key="Texto" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Acento" Color="#1F4E79" />
    <SolidColorBrush x:Key="Error" Color="#B00020" />
    <SolidColorBrush x:Key="Aviso" Color="#FFF4CE" />

    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{StaticResource FondoVentana}" />
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Borde}" />
    </Style>

    <Style x:Key="BotonPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{StaticResource Texto}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TextoError" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Error}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="4,2" />
    </Style>

</ResourceDictionary>
