<Window x:Class="Condor.Escritorio.Vistas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Icon="/Recursos/condor.png"
        Width="1440" Height="880" MinWidth="1180" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FocusManager.FocusedElement="{Binding ElementName=CampoProducto}"
        KeyDown="Ventana_KeyDown">

    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="NuevoProducto_Click" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="New" />
        <KeyBinding Key="F2" Command="{Binding ModuloPendienteCommand}" CommandParameter="Catálogo" />
        <KeyBinding Key="F3" Command="{Binding ModuloPendienteCommand}" CommandParameter="Clientes" />
        <KeyBinding Key="F4" Command="{Binding ModuloPendienteCommand}" CommandParameter="Compras" />
        <KeyBinding Key="F5" Command="{Binding ModuloPendienteCommand}" CommandParameter="Historial" />
        <KeyBinding Key="F9" Command="{Binding ModuloPendienteCommand}" CommandParameter="Respaldo" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================
             Menú lateral: marca, sede, módulos y el Misti al fondo.
             ============================================================ -->
        <Grid Background="{StaticResource Lateral}" ClipToBounds="True">
            <Rectangle Fill="{StaticResource PapelOscuro}" IsHitTestVisible="False" />

            <!-- Volcán centrado bajo el menú; la cima de la imagen está un 6 % a la
                 derecha, por eso el margen asimétrico. Se desvanece hacia abajo. -->
            <Image Source="/Recursos/volcan.png" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   Stretch="Uniform" Width="470" Margin="-200,0,-144,-6" Opacity="0.3" IsHitTestVisible="False">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="0.55" />
                        <GradientStop Color="#33000000" Offset="1" />
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>

            <StackPanel>
                <!-- Marca -->
                <StackPanel Margin="0,42,0,0" HorizontalAlignment="Center">
                    <Image Source="/Recursos/condor.png" Width="136" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="F&#x2009;E&#x2009;R&#x2009;R&#x2009;E&#x2009;T&#x2009;E&#x2009;R&#x2009;Í&#x2009;A" Style="{StaticResource TituloSerif}" FontWeight="SemiBold" FontSize="20"
                               Foreground="#E58A62" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="C&#x2009;Ó&#x2009;N&#x2009;D&#x2009;O&#x2009;R" Style="{StaticResource TituloSerif}" FontSize="23"
                               Foreground="#E58A62" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                    <TextBlock Text="M&#x2002;A&#x2002;J&#x2002;E&#x2002;S" FontSize="11" FontWeight="SemiBold" Foreground="#E58A62"
                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                    <Border Height="1.5" Width="146" Background="#DC8761" Margin="0,13,0,0" />
                </StackPanel>

                <!-- Sede -->
                <StackPanel Orientation="Horizontal" Margin="35,20,0,26">
                    <!-- Pin de ubicación -->
                    <Canvas Width="16" Height="21" VerticalAlignment="Top" Margin="0,4,14,0">
                        <Path Stroke="{StaticResource LateralTexto}" StrokeThickness="1.8" StrokeLineJoin="Round"
                              Data="M8,20 C8,20 1,12.5 1,8 A7,7 0 0 1 15,8 C15,12.5 8,20 8,20 Z" />
                        <Ellipse Canvas.Left="5.2" Canvas.Top="5.2" Width="5.6" Height="5.6"
                                 Stroke="{StaticResource LateralTexto}" StrokeThickness="1.8" />
                    </Canvas>
                    <StackPanel>
                        <TextBlock Text="Majes" Foreground="{StaticResource LateralTexto}" FontSize="14" />
                        <TextBlock Text="Arequipa, Perú" Foreground="{StaticResource LateralTexto}" FontSize="14" />
                    </StackPanel>
                </StackPanel>

                <!-- Módulos -->
                <Button Style="{StaticResource BotonMenuActivo}" Tag="&#xE7BF;" IsHitTestVisible="False" Focusable="False">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Tecla}" Text="F1" Foreground="#F3DED3" />
                        <TextBlock Text="Nueva venta" FontWeight="SemiBold" />
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource BotonMenu}" Tag="&#xE8FD;" Focusable="False"
                        Command="{Binding ModuloPendienteCommand}" CommandParameter="Catálogo">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Tecla}" Text="F2" />
                        <TextBlock Text="Catálogo" />
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource BotonMenu}" Tag="&#xE77B;" Focusable="False"
                        Command="{Binding ModuloPendienteCommand}" CommandParameter="Clientes">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Tecla}" Text="F3" />
                        <TextBlock Text="Clientes" />
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource BotonMenu}" Tag="&#xE8A5;" Focusable="False"
                        Command="{Binding ModuloPendienteCommand}" CommandParameter="Compras">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Tecla}" Text="F4" />
                        <TextBlock Text="Compras" />
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource BotonMenu}" Tag="&#xE823;" Focusable="False"
                        Command="{Binding ModuloPendienteCommand}" CommandParameter="Historial">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Tecla}" Text="F5" />
                        <TextBlock Text="Historial" />
                    </DockPanel>
                </Button>
                <Button Style="{StaticResource BotonMenu}" Tag="&#xE753;" Focusable="False"
                        Command="{Binding ModuloPendienteCommand}" CommandParameter="Respaldo">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Tecla}" Text="F9" />
                        <TextBlock Text="Respaldo" />
                    </DockPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================
             Contenido: Nueva venta.
             ============================================================ -->
        <Rectangle Grid.Column="1" Fill="{StaticResource Papel}" IsHitTestVisible="False" />
        <DockPanel Grid.Column="1">

            <!-- Greca andina -->
            <Border DockPanel.Dock="Top" Height="13" Background="{StaticResource Greca}" />

            <!-- Pie: usuario, terminal, conexión y mensaje de estado. -->
            <Border DockPanel.Dock="Bottom" Padding="36,0,34,0" Height="60"
                    BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
                <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" Text="&#xE701;" Style="{StaticResource Icono}" FontSize="18"
                               Margin="18,0,0,0" ToolTip="Red local" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="&#xEA8C;" Style="{StaticResource Icono}" FontSize="16" Margin="0,0,14,0" />
                        <TextBlock Text="{Binding Usuario}" />
                        <TextBlock Text="·" Margin="12,0" Foreground="{StaticResource TextoSuave}" />
                        <TextBlock Text="{Binding Terminal}" Margin="0,0,20,0" />

                        <!-- Indicador de conexión (T-06). -->
                        <StackPanel Orientation="Horizontal" DataContext="{Binding Conexion}">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,1,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Exito}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Conectado, FallbackValue=False}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Conectado" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Conectado, FallbackValue=False}" Value="False">
                                                <Setter Property="Text" Value="Sin conexión" />
                                                <Setter Property="Foreground" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource TextoSuave}" FontSize="13"
                               Margin="28,0,0,0" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <Grid Margin="36,26,26,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="372" />
                </Grid.ColumnDefinitions>

                <!-- Encabezado: título, fecha y hora. -->
                <TextBlock Text="Nueva venta" Style="{StaticResource TituloSerif}" FontSize="58" Margin="-2,0,0,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,-12,0">
                    <TextBlock Text="&#xE787;" Style="{StaticResource Icono}" FontSize="18" Margin="0,0,14,0" />
                    <TextBlock x:Name="Fecha" FontSize="15" Margin="0,0,14,0" />
                    <TextBlock x:Name="Hora" FontSize="15" />
                </StackPanel>

                <!-- Aviso de pérdida de conexión (T-06): no borra nada de la pantalla. -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" Padding="16,10" CornerRadius="5"
                        Background="{StaticResource ErrorSuave}" BorderBrush="#E8B9AE" BorderThickness="1"
                        DataContext="{Binding Conexion}"
                        Visibility="{Binding Aviso, Converter={StaticResource NuloAOculto}, FallbackValue=Collapsed}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="_Reintentar" Height="34" Command="{Binding ReintentarCommand}" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icono}" Foreground="{StaticResource Error}"
                                   Margin="0,0,12,0" />
                        <TextBlock Text="{Binding Aviso}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource Error}" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>

                <!-- Línea tenue bajo el título. -->
                <Border Grid.Row="2" Height="1" Background="{StaticResource Borde}" VerticalAlignment="Top" Margin="0,14,0,0" />

                <!-- Columna izquierda: búsqueda y detalle. -->
                <Grid Grid.Row="2" Margin="0,24,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Búsqueda (HU-02, T-16) + cantidad y Agregar (T-17). -->
                    <Grid Panel.ZIndex="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="21" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="13" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Content="_Producto" Target="{Binding ElementName=CampoProducto}" />
                        <Label Grid.Column="2" Content="C_antidad" Target="{Binding ElementName=CampoCantidad}" VerticalAlignment="Bottom" />

                        <Grid Grid.Row="1" DataContext="{Binding Buscador}" VerticalAlignment="Top" Margin="0,0,0,0">
                            <TextBox x:Name="CampoProducto" FontSize="16" MinHeight="42" Padding="44,0,10,0"
                                     Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="CampoProducto_PreviewKeyDown"
                                     ToolTip="Escriba 3 letras o más del nombre del producto." />
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icono}" FontSize="17" Margin="14,0,0,0" IsHitTestVisible="False"
                                       HorizontalAlignment="Left" Foreground="{StaticResource Texto}" />
                            <TextBlock Text="Buscar producto…  (cemento, clavo, tubo)" IsHitTestVisible="False"
                                       Margin="44,0,10,0" VerticalAlignment="Center" FontSize="15"
                                       Foreground="{StaticResource TextoTenue}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=CampoProducto}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Popup IsOpen="{Binding MostrarSugerencias, Mode=OneWay}" PlacementTarget="{Binding ElementName=CampoProducto}"
                                   Placement="Bottom" VerticalOffset="-8" HorizontalOffset="-10" StaysOpen="False" AllowsTransparency="True">
                                <Border Margin="10,2,10,16" Padding="0,6" CornerRadius="5" Background="{StaticResource Superficie}"
                                        BorderBrush="{StaticResource Borde}" BorderThickness="1" Effect="{StaticResource SombraFuerte}"
                                        Width="{Binding ActualWidth, ElementName=CampoProducto}">
                                    <ListBox x:Name="ListaSugerencias" MaxHeight="360" ItemsSource="{Binding Sugerencias}"
                                             BorderThickness="0" Background="Transparent"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource ItemSugerencia}"
                                             SelectedItem="{Binding Seleccionado}"
                                             PreviewKeyDown="ListaSugerencias_PreviewKeyDown"
                                             MouseDoubleClick="ListaSugerencias_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource Miniatura}" Width="32" Height="38" Margin="0,0,16,0">
                                                        <TextBlock Text="&#xE7B8;" Style="{StaticResource Icono}" FontSize="16"
                                                                   HorizontalAlignment="Center" Foreground="#8C7B6B" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Nombre}" FontSize="14.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="12" Opacity="0.85" Margin="0,1,0,0">
                                                            <Run Text="{Binding Unidad, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding Precio, Mode=OneWay, StringFormat='S/ {0:0.00}'}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Cantidad con flechas. -->
                        <Grid Grid.Row="1" Grid.Column="2" Width="112" VerticalAlignment="Bottom" Margin="0,0,0,1" DataContext="{Binding Venta}">
                            <TextBox x:Name="CampoCantidad" MinHeight="46" FontSize="16" Padding="12,0,30,0"
                                     Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                                     GotKeyboardFocus="CampoCantidad_GotKeyboardFocus"
                                     PreviewKeyDown="CampoCantidad_PreviewKeyDown" />
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                <RepeatButton Style="{StaticResource BotonFlecha}" Content="&#xE70E;" Height="18" Click="SubirCantidad_Click"
                                              ToolTip="Aumentar (flecha arriba)" />
                                <RepeatButton Style="{StaticResource BotonFlecha}" Content="&#xE70D;" Height="18" Click="BajarCantidad_Click"
                                              ToolTip="Disminuir (flecha abajo)" />
                            </StackPanel>
                        </Grid>

                        <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource BotonPrincipal}" Height="49" Padding="16,0,18,0"
                                FontSize="17" VerticalAlignment="Bottom" Command="{Binding Venta.AgregarCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="22" Height="22" Margin="0,0,10,0">
                                    <Ellipse Fill="White" />
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icono}" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" Foreground="{StaticResource Acento}" />
                                </Grid>
                                <AccessText Text="_Agregar" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="1" Grid.Column="6" Height="49" Padding="10,0" FontSize="13" VerticalAlignment="Bottom"
                                Click="NuevoProducto_Click"
                                ToolTip="Registrar un producto que no está en el catálogo (Ctrl+N).">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icono}" FontSize="11" Margin="0,0,8,0" />
                                <TextBlock Text="Nuevo producto" />
                            </StackPanel>
                        </Button>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="7">
                            <TextBlock Style="{StaticResource TextoError}" Text="{Binding Buscador.Error}"
                                       Visibility="{Binding Buscador.Error, Converter={StaticResource NuloAOculto}}" />
                            <TextBlock Style="{StaticResource TextoError}" Text="{Binding Venta.Error}"
                                       Visibility="{Binding Venta.Error, Converter={StaticResource NuloAOculto}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Detalle de la venta (T-17). La cantidad se puede corregir en la tabla. -->
                    <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,26,0,62">
                        <Border CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <DataGrid ItemsSource="{Binding Venta.Detalle}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          CanUserReorderColumns="False" CanUserResizeRows="False" CanUserResizeColumns="False"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource Borde}"
                                          Background="Transparent" BorderThickness="0" FontSize="15" RowHeight="72"
                                          VerticalScrollBarVisibility="Auto"
                                          ColumnHeaderStyle="{StaticResource CabeceraTabla}"
                                          CellStyle="{StaticResource CeldaTabla}" RowStyle="{StaticResource FilaTabla}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="N.°" Binding="{Binding Item}" IsReadOnly="True" Width="56"
                                                            HeaderStyle="{StaticResource CabeceraNumero}" ElementStyle="{StaticResource Centrado}" />
                                        <DataGridTemplateColumn Header="Producto" Width="*" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Style="{StaticResource Miniatura}" Width="52" Height="52" Margin="0,0,22,0">
                                                            <TextBlock Text="&#xE7B8;" Style="{StaticResource Icono}" FontSize="22"
                                                                       HorizontalAlignment="Center" Foreground="#8C7B6B" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Descripcion}" VerticalAlignment="Center" FontSize="14.5" Margin="0,0,0,6"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat='0.###'}" Width="100"
                                                            HeaderStyle="{StaticResource CabeceraNumero}" ElementStyle="{StaticResource Centrado}" />
                                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" IsReadOnly="True" Width="100"
                                                            HeaderStyle="{StaticResource CabeceraNumero}" ElementStyle="{StaticResource Centrado}" />
                                        <DataGridTextColumn Header="Precio unit." Binding="{Binding PrecioUnitario, StringFormat='0.00'}" IsReadOnly="True" Width="116"
                                                            HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Importe, StringFormat='0.00', Mode=OneWay}" IsReadOnly="True" Width="112"
                                                            HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                                        <DataGridTemplateColumn Width="64">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource BotonQuitar}" HorizontalAlignment="Center"
                                                            Command="{Binding DataContext.Venta.QuitarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Estado vacío. -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,48,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Venta.Detalle.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xE7BF;" Style="{StaticResource Icono}" FontSize="34"
                                               HorizontalAlignment="Center" Foreground="{StaticResource TextoTenue}" />
                                    <TextBlock Text="Aún no hay productos en la venta" Style="{StaticResource TituloSerif}" FontSize="18"
                                               HorizontalAlignment="Center" Margin="0,14,0,4" />
                                    <TextBlock Text="Escriba el nombre en Producto, elija con Enter y vuelva a pulsar Enter para agregar."
                                               Foreground="{StaticResource TextoSuave}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>

                <!-- Columna derecha: cliente y resumen. Se desplaza si la pantalla es baja. -->
                <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              Margin="-10,0,-10,0" Padding="10,0,10,16">
                <StackPanel>

                <!-- Cliente (HU-03, T-23): un solo campo DNI o RUC; Enter busca. -->
                <Border Style="{StaticResource Tarjeta}" Padding="24,18,20,20" Margin="0,0,0,16"
                        DataContext="{Binding Cliente}"
                        Visibility="{Binding Converter={StaticResource NuloAOculto}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="&#xE77B;" Style="{StaticResource Icono}" FontSize="18" Margin="0,0,12,0"
                                       Foreground="{StaticResource Acento}" />
                            <TextBlock Text="Cliente" Style="{StaticResource TituloSerif}" FontSize="24" />
                        </DockPanel>

                        <Label Content="_DNI o RUC" Target="{Binding ElementName=CampoDocumento}" FontSize="13" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CampoDocumento" FontSize="15" MaxLength="13"
                                     Text="{Binding Documento, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="8 dígitos para DNI u 11 para RUC. Enter busca al cliente.">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding BuscarCommand}" />
                                </TextBox.InputBindings>
                                <!-- Criterio 3 de HU-03: el campo se marca en rojo si el documento no es válido. -->
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TieneError}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource Error}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="2" Height="40" Padding="14,0" Command="{Binding BuscarCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                                    <AccessText Text="_Buscar" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Style="{StaticResource TextoError}" Text="{Binding Error}"
                                   Visibility="{Binding Error, Converter={StaticResource NuloAOculto}}" />

                        <!-- Cliente encontrado: nombre o razón social y dirección. -->
                        <Border Margin="0,12,0,0" Padding="14,10,6,10" CornerRadius="5" Background="{StaticResource SuperficieAlterna}"
                                Visibility="{Binding Seleccionado, Converter={StaticResource NuloAOculto}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource BotonQuitar}" VerticalAlignment="Top"
                                        Command="{Binding QuitarCommand}" ToolTip="Quitar el cliente de la venta" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Seleccionado.Nombre}" FontWeight="SemiBold" FontSize="14.5" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Seleccionado.Documento}" FontSize="12.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextoSuave}" />
                                    <TextBlock Text="{Binding Seleccionado.Direccion}" FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextoSuave}"
                                               Visibility="{Binding Seleccionado.Direccion, Converter={StaticResource NuloAOculto}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Margin="2,10,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextoSuave}"
                                   Text="Ese documento no está registrado. Pulse Nuevo cliente para registrarlo."
                                   Visibility="{Binding NoEncontrado, Converter={StaticResource BoolAVisible}}" />

                        <!-- Sin cliente: la boleta sale sin DNI. -->
                        <TextBlock Margin="2,10,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextoTenue}"
                                   Text="Sin cliente: la boleta se emite sin DNI.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HayCliente}" Value="False" />
                                                <Condition Binding="{Binding NoEncontrado}" Value="False" />
                                                <Condition Binding="{Binding TieneError}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Registrar al cliente que no se encontró (HU-03, T-24). -->
                        <Button HorizontalAlignment="Left" Margin="0,14,0,0" Height="38" Padding="12,0" FontSize="13"
                                Click="NuevoCliente_Click" ToolTip="Registrar un cliente con su DNI o RUC (Alt+L).">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icono}" FontSize="11" Margin="0,0,8,0" />
                                <AccessText Text="Nuevo c_liente" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Resumen. Los precios incluyen IGV (18 %). -->
                <Border Style="{StaticResource Tarjeta}" Padding="26,22,20,26">
                    <StackPanel>
                        <TextBlock Text="Resumen de venta" Style="{StaticResource TituloSerif}" FontSize="30" Margin="0,0,0,18" />

                        <!-- Tipo de comprobante (HU-05, T-29). La factura llega con HU-06. -->
                        <UniformGrid Columns="3" Margin="0,0,0,24" DataContext="{Binding Emision}"
                                     Visibility="{Binding Converter={StaticResource NuloAOculto}, FallbackValue=Collapsed}">
                            <RadioButton Style="{StaticResource OpcionComprobante}" GroupName="TipoComprobante"
                                         Content="Boleta" IsChecked="{Binding EsBoleta}" ToolTip="Boleta sin DNI (hasta S/ 700.00)." />
                            <RadioButton Style="{StaticResource OpcionComprobante}" GroupName="TipoComprobante"
                                         Content="Con DNI" IsChecked="{Binding EsBoletaConDni}" ToolTip="Boleta con el DNI del cliente." />
                            <RadioButton Style="{StaticResource OpcionComprobante}" GroupName="TipoComprobante"
                                         Content="Factura" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
                                         ToolTip="La factura con RUC se habilita con HU-06 (Sprint 4)." />
                        </UniformGrid>

                        <DockPanel Margin="0,0,6,24">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Venta.OpGravada, StringFormat='S/ {0:0.00}'}" FontSize="17" />
                            <TextBlock Text="Op. gravada" FontSize="17" />
                        </DockPanel>
                        <DockPanel Margin="0,0,6,22">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Venta.Igv, StringFormat='S/ {0:0.00}'}" FontSize="17" />
                            <TextBlock Text="IGV (18 %)" FontSize="17" />
                        </DockPanel>

                        <Border Height="1" Background="{StaticResource BordeFuerte}" Margin="0,0,6,34" />

                        <TextBlock Text="TOTAL" Style="{StaticResource TituloSerif}" FontSize="22" Foreground="{StaticResource Acento}" />
                        <TextBlock Style="{StaticResource TituloSerif}" FontSize="62" Foreground="{StaticResource Acento}"
                                   HorizontalAlignment="Right" Margin="0,-12,-4,24"
                                   Text="{Binding Venta.Total, StringFormat='S/ {0:0.00}'}" />

                        <!-- Emite la boleta con el siguiente número de B001 (HU-05, T-29). -->
                        <Button Style="{StaticResource BotonEmitir}" Height="68" FontSize="19" Margin="0,0,6,0"
                                Command="{Binding Emision.EmitirCommand}" ToolTipService.ShowOnDisabled="True"
                                ToolTip="Guarda el comprobante en la base central e imprime el ticket (F10).">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE749;" Style="{StaticResource Icono}" FontSize="26" Margin="0,0,22,0" />
                                <TextBlock Text="Emitir e imprimir" VerticalAlignment="Center" />
                                <TextBlock Text=" (F10)" FontWeight="Normal" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Por qué no se emitió: falta el DNI, sin conexión... -->
                        <Border Margin="0,12,6,0" Padding="12,9" CornerRadius="5" Background="{StaticResource ErrorSuave}"
                                Visibility="{Binding Emision.Error, Converter={StaticResource NuloAOculto}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding Emision.Error}" Style="{StaticResource TextoError}" Margin="0" />
                        </Border>

                        <!-- Descarta la venta en curso; también con Esc. -->
                        <Button Height="46" FontSize="15" Margin="0,12,6,0" Click="CancelarVenta_Click"
                                ToolTip="Descartar la venta en curso (Esc).">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,10,0" />
                                <TextBlock Text="Cancelar venta" VerticalAlignment="Center" />
                                <TextBlock Text=" (Esc)" FontWeight="Normal" VerticalAlignment="Center" Foreground="{StaticResource TextoSuave}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
