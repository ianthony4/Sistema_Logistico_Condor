<Window x:Class="Condor.Escritorio.Vistas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=CampoProducto}">

    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding ModuloPendienteCommand}" CommandParameter="Catálogo" />
        <KeyBinding Key="F3" Command="{Binding ModuloPendienteCommand}" CommandParameter="Clientes" />
        <KeyBinding Key="F4" Command="{Binding ModuloPendienteCommand}" CommandParameter="Compras" />
        <KeyBinding Key="F5" Command="{Binding ModuloPendienteCommand}" CommandParameter="Historial" />
        <KeyBinding Key="F9" Command="{Binding ModuloPendienteCommand}" CommandParameter="Respaldo" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Cabecera: nombre del local, terminal y perfil (wireframe del Lab 03). -->
        <Border DockPanel.Dock="Top" Background="{StaticResource FondoCabecera}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="16" />
                <TextBlock Margin="40,0,0,0" FontSize="16">
                    <Run Text="Terminal:" FontWeight="Bold" />
                    <Run Text="{Binding Terminal, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="30,0,0,0" FontSize="16">
                    <Run Text="Usuario:" FontWeight="Bold" />
                    <Run Text="{Binding Usuario, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Barra de módulos. -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="8,6">
            <Button Content="F1 Nueva venta" IsEnabled="False" />
            <Button Content="F2 Catálogo" Command="{Binding ModuloPendienteCommand}" CommandParameter="Catálogo" />
            <Button Content="F3 Clientes" Command="{Binding ModuloPendienteCommand}" CommandParameter="Clientes" />
            <Button Content="F4 Compras" Command="{Binding ModuloPendienteCommand}" CommandParameter="Compras" />
            <Button Content="F5 Historial" Command="{Binding ModuloPendienteCommand}" CommandParameter="Historial" />
            <Button Content="F9 Respaldo" Command="{Binding ModuloPendienteCommand}" CommandParameter="Respaldo" />
        </UniformGrid>

        <!-- Barra de estado. -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Mensaje}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Contenido de la venta. -->
        <Grid Margin="12,4,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Campo Producto con autocompletado (HU-02, T-16). -->
            <DockPanel Grid.Row="0" DataContext="{Binding Buscador}">
                <Label DockPanel.Dock="Left" Content="_Producto:" Target="{Binding ElementName=CampoProducto}" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TextoError}" Text="{Binding Error}"
                           Visibility="{Binding Error, Converter={StaticResource NuloAOculto}}" />
                <Grid>
                    <TextBox x:Name="CampoProducto" FontSize="16"
                             Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CampoProducto_PreviewKeyDown"
                             ToolTip="Escriba 3 letras o más del nombre del producto." />
                    <TextBlock Text="Buscar por nombre... (autocompleta)" IsHitTestVisible="False"
                               Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Borde}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CampoProducto}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Popup IsOpen="{Binding MostrarSugerencias, Mode=OneWay}" PlacementTarget="{Binding ElementName=CampoProducto}"
                           Placement="Bottom" StaysOpen="False" Width="{Binding ActualWidth, ElementName=CampoProducto}">
                        <ListBox x:Name="ListaSugerencias" MaxHeight="320" ItemsSource="{Binding Sugerencias}"
                                 HorizontalContentAlignment="Stretch"
                                 SelectedItem="{Binding Seleccionado}"
                                 PreviewKeyDown="ListaSugerencias_PreviewKeyDown"
                                 MouseDoubleClick="ListaSugerencias_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right" Margin="0,0,24,0" FontWeight="Bold"
                                                   Text="{Binding Precio, StringFormat='S/ {0:0.00}'}" />
                                        <TextBlock DockPanel.Dock="Right" Margin="0,0,16,0" Foreground="{StaticResource Borde}"
                                                   Text="{Binding Unidad}" />
                                        <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Popup>
                </Grid>
            </DockPanel>

            <!-- Detalle de la venta (se completa en T-17). -->
            <Border Grid.Row="1" Margin="0,8,0,0" BorderBrush="{StaticResource Borde}" BorderThickness="1" Background="White" />
        </Grid>
    </DockPanel>
</Window>
