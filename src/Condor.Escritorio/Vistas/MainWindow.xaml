<Window x:Class="Condor.Escritorio.Vistas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}"
        Width="1100" Height="720" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=CampoProducto}"
        KeyDown="Ventana_KeyDown">

    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="NuevoProducto_Click" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="New" />
        <KeyBinding Key="F2" Command="{Binding ModuloPendienteCommand}" CommandParameter="Catálogo" />
        <KeyBinding Key="F3" Command="{Binding ModuloPendienteCommand}" CommandParameter="Clientes" />
        <KeyBinding Key="F4" Command="{Binding ModuloPendienteCommand}" CommandParameter="Compras" />
        <KeyBinding Key="F5" Command="{Binding ModuloPendienteCommand}" CommandParameter="Historial" />
        <KeyBinding Key="F9" Command="{Binding ModuloPendienteCommand}" CommandParameter="Respaldo" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Cabecera: nombre del local, terminal y perfil (wireframe del Lab 03). -->
        <Border DockPanel.Dock="Top" Background="{StaticResource FondoCabecera}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Titulo}" FontWeight="Bold" FontSize="16" />
                <TextBlock Margin="40,0,0,0" FontSize="16">
                    <Run Text="Terminal:" FontWeight="Bold" />
                    <Run Text="{Binding Terminal, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="30,0,0,0" FontSize="16">
                    <Run Text="Usuario:" FontWeight="Bold" />
                    <Run Text="{Binding Usuario, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Aviso de pérdida de conexión (T-06): no borra nada de la pantalla. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Aviso}" BorderBrush="{StaticResource Error}"
                BorderThickness="0,0,0,2" Padding="12,6" DataContext="{Binding Conexion}"
                Visibility="{Binding Aviso, Converter={StaticResource NuloAOculto}, FallbackValue=Collapsed}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="_Reintentar" Command="{Binding ReintentarCommand}" />
                <TextBlock Text="{Binding Aviso}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource Error}" FontWeight="Bold" />
            </DockPanel>
        </Border>

        <!-- Barra de módulos. -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="8,6">
            <Button Content="F1 Nueva venta" IsEnabled="False" />
            <Button Content="F2 Catálogo" Command="{Binding ModuloPendienteCommand}" CommandParameter="Catálogo" />
            <Button Content="F3 Clientes" Command="{Binding ModuloPendienteCommand}" CommandParameter="Clientes" />
            <Button Content="F4 Compras" Command="{Binding ModuloPendienteCommand}" CommandParameter="Compras" />
            <Button Content="F5 Historial" Command="{Binding ModuloPendienteCommand}" CommandParameter="Historial" />
            <Button Content="F9 Respaldo" Command="{Binding ModuloPendienteCommand}" CommandParameter="Respaldo" />
        </UniformGrid>

        <!-- Barra de estado. -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Mensaje}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Contenido de la venta. -->
        <Grid Margin="12,4,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Cantidad, Agregar y Nuevo producto (T-17, T-13). -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        DataContext="{Binding Venta}">
                <Label Content="C_ant.:" Target="{Binding ElementName=CampoCantidad}" />
                <TextBox x:Name="CampoCantidad" Width="70" FontSize="16" TextAlignment="Right"
                         Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}"
                         GotKeyboardFocus="CampoCantidad_GotKeyboardFocus"
                         PreviewKeyDown="CampoCantidad_PreviewKeyDown" />
                <Button Content="_Agregar" Style="{StaticResource BotonPrincipal}" Command="{Binding AgregarCommand}" />
                <Button Content="+ Nuevo prod." Click="NuevoProducto_Click"
                        ToolTip="Registrar un producto que no está en el catálogo (Ctrl+N)." />
            </StackPanel>

            <!-- Campo Producto con autocompletado (HU-02, T-16). -->
            <DockPanel Grid.Row="0" DataContext="{Binding Buscador}">
                <Label DockPanel.Dock="Left" Content="_Producto:" Target="{Binding ElementName=CampoProducto}" />
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource TextoError}" Text="{Binding Error}"
                           Visibility="{Binding Error, Converter={StaticResource NuloAOculto}}" />
                <Grid>
                    <TextBox x:Name="CampoProducto" FontSize="16"
                             Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CampoProducto_PreviewKeyDown"
                             ToolTip="Escriba 3 letras o más del nombre del producto." />
                    <TextBlock Text="Buscar por nombre... (autocompleta)" IsHitTestVisible="False"
                               Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource Borde}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=CampoProducto}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Popup IsOpen="{Binding MostrarSugerencias, Mode=OneWay}" PlacementTarget="{Binding ElementName=CampoProducto}"
                           Placement="Bottom" StaysOpen="False" Width="{Binding ActualWidth, ElementName=CampoProducto}">
                        <ListBox x:Name="ListaSugerencias" MaxHeight="320" ItemsSource="{Binding Sugerencias}"
                                 HorizontalContentAlignment="Stretch"
                                 SelectedItem="{Binding Seleccionado}"
                                 PreviewKeyDown="ListaSugerencias_PreviewKeyDown"
                                 MouseDoubleClick="ListaSugerencias_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right" Margin="0,0,24,0" FontWeight="Bold"
                                                   Text="{Binding Precio, StringFormat='S/ {0:0.00}'}" />
                                        <TextBlock DockPanel.Dock="Right" Margin="0,0,16,0" Foreground="{StaticResource Borde}"
                                                   Text="{Binding Unidad}" />
                                        <TextBlock Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Popup>
                </Grid>
            </DockPanel>

            <!-- Detalle de la venta (T-17). La cantidad se puede corregir en la tabla. -->
            <DataGrid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" ItemsSource="{Binding Venta.Detalle}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" FontSize="15" RowHeight="30">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N.°" Binding="{Binding Item}" IsReadOnly="True" Width="50" />
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Und." Binding="{Binding Unidad}" IsReadOnly="True" Width="60" />
                    <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad, StringFormat='0.###'}" Width="80" />
                    <DataGridTextColumn Header="P. unit." Binding="{Binding PrecioUnitario, StringFormat='0.00'}" IsReadOnly="True" Width="90" />
                    <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat='0.00', Mode=OneWay}" IsReadOnly="True" Width="100" />
                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Quitar" Margin="2" Padding="4,0" MinWidth="0"
                                        Command="{Binding DataContext.Venta.QuitarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Totales: los precios incluyen IGV (18 %). -->
            <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="12,8" Background="White"
                    BorderBrush="{StaticResource Borde}" BorderThickness="1" DataContext="{Binding Venta}">
                <Grid HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Op. gravada:" />
                    <TextBlock Grid.Column="1" TextAlignment="Right" Text="{Binding OpGravada, StringFormat='0.00'}" />
                    <TextBlock Grid.Row="1" Text="IGV (18 %):" />
                    <TextBlock Grid.Row="1" Grid.Column="1" TextAlignment="Right" Text="{Binding Igv, StringFormat='0.00'}" />
                    <TextBlock Grid.Row="2" Text="TOTAL S/." FontSize="20" FontWeight="Bold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" TextAlignment="Right" FontSize="20" FontWeight="Bold"
                               Text="{Binding Total, StringFormat='0.00'}" />
                </Grid>
            </Border>

            <!-- Acciones de la venta. Emitir llega en el Sprint 2 (HU-05). -->
            <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Cancelar (Esc)" Width="160" Click="CancelarVenta_Click" />
                <Button DockPanel.Dock="Right" Content="EMITIR E IMPRIMIR (F10)" Width="280" FontSize="16"
                        Style="{StaticResource BotonPrincipal}" IsEnabled="False"
                        ToolTip="La emisión de boletas y facturas se implementa en el Sprint 2 (HU-05)." />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
