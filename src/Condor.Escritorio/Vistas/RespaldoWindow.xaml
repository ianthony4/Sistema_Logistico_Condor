<Window x:Class="Condor.Escritorio.Vistas.RespaldoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Respaldo de la base de datos"
        Width="900" Height="640" MinWidth="760" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Superficie}"
        FocusManager.FocusedElement="{Binding ElementName=BotonGenerar}"
        Closing="Ventana_Closing">

    <DockPanel>
        <!-- Encabezado. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,16">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE753;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Respaldo de la base de datos" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Conecte el disco externo a la PC principal y pulse Generar respaldo. Se guarda todo: catálogo, clientes, comprobantes y proveedores."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Acciones. -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cerrar" Width="120" IsCancel="True" Click="Cerrar_Click" />
                    <Button x:Name="BotonGenerar" Width="230" Margin="12,0,0,0" IsDefault="True"
                            Style="{StaticResource BotonPrincipal}" Command="{Binding GenerarCommand}"
                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding Indicacion}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Icono}" FontSize="14" Margin="0,0,8,0" />
                            <AccessText Text="_Generar respaldo" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding TextoUltimo}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextoSuave}" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="28,0,28,16">
            <!-- Carpeta del disco externo (sección Respaldo de condor.json). -->
            <Label Content="_Carpeta del disco externo" Target="{Binding ElementName=CampoCarpeta}" FontSize="13" Padding="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CampoCarpeta" FontSize="15" IsEnabled="{Binding PuedeGenerar}"
                         Text="{Binding Carpeta, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Si Windows le dio otra letra al disco, corríjala aquí." />
                <Button Grid.Column="2" Height="40" Padding="14,0" Click="Examinar_Click" IsEnabled="{Binding PuedeGenerar}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="_Examinar…" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- En las PC que no son la principal no se puede generar. -->
            <TextBlock Text="{Binding Indicacion}" Margin="2,8,0,0" FontSize="13" TextWrapping="Wrap"
                       Foreground="{StaticResource TextoSuave}"
                       Visibility="{Binding Indicacion, Converter={StaticResource NuloAOculto}}" />

            <!-- Progreso (criterio 1 de HU-15). -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding Generando, Converter={StaticResource BoolAVisible}}">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Porcentaje, StringFormat='{}{0} %'}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Paso}" Foreground="{StaticResource TextoSuave}" FontSize="13" />
                </DockPanel>
                <ProgressBar Height="12" Minimum="0" Maximum="100" Value="{Binding Porcentaje, Mode=OneWay}"
                             Foreground="{StaticResource Acento}" Background="{StaticResource SuperficieAlterna}"
                             BorderThickness="0" />
            </StackPanel>

            <!-- Confirmación al terminar. -->
            <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="5" Background="{StaticResource ExitoSuave}"
                    Visibility="{Binding Mensaje, Converter={StaticResource NuloAOculto}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icono}" FontSize="15"
                               Foreground="{StaticResource Exito}" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" FontSize="13.5" />
                </DockPanel>
            </Border>

            <!-- Disco desconectado, sin espacio, sin pg_dump... -->
            <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="5" Background="{StaticResource ErrorSuave}"
                    Visibility="{Binding Error, Converter={StaticResource NuloAOculto}}">
                <TextBlock Text="{Binding Error}" Style="{StaticResource TextoError}" Margin="0" />
            </Border>
        </StackPanel>

        <!-- Últimos respaldos de cualquier PC. -->
        <Border Style="{StaticResource Tarjeta}" Margin="28,0,28,20">
            <DataGrid ItemsSource="{Binding Recientes}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Borde}" Background="Transparent" BorderThickness="0"
                      FontSize="14" RowHeight="38" FocusVisualStyle="{x:Null}"
                      ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                      RowStyle="{StaticResource FilaTabla}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding TerminadoEn.LocalDateTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="160" />
                    <DataGridTextColumn Header="Archivo" Binding="{Binding Archivo}" Width="*" />
                    <DataGridTextColumn Header="Tamaño" Binding="{Binding Tamano}" Width="100"
                                        HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                    <DataGridTextColumn Header="PC" Binding="{Binding TerminalNombre}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
