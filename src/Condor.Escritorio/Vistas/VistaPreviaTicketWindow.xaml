<Window x:Class="Condor.Escritorio.Vistas.VistaPreviaTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa del ticket"
        SizeToContent="WidthAndHeight" MaxHeight="820"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SuperficieAlterna}">

    <DockPanel>
        <!-- Acciones. -->
        <Border DockPanel.Dock="Bottom" Padding="24,14" Background="{StaticResource Superficie}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Width="130" IsDefault="True" IsCancel="True"
                        Style="{StaticResource BotonPrincipal}" Click="Cerrar_Click">
                    <AccessText Text="_Cerrar" />
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextoSuave}"
                           TextWrapping="Wrap" Margin="0,0,16,0" MaxWidth="330"
                           Text="Esta PC no tiene ticketera en condor.json (Ticketera &gt; Nombre)." />
            </DockPanel>
        </Border>

        <!-- El papel: 80 mm de ancho con letra de ancho fijo, como en la ticketera. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <Border Background="White" Padding="18,22" Effect="{StaticResource Sombra}" HorizontalAlignment="Center">
                <TextBlock x:Name="Texto" FontFamily="Consolas" FontSize="13" Foreground="#222" />
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
