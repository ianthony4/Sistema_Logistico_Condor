<!-- Compras a proveedores (F4, HU-11, T-82) en el panel derecho de la ventana principal. -->
<UserControl x:Class="Condor.Escritorio.Vistas.Modulos.ComprasVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Alt" Command="New" />
    </UserControl.InputBindings>

    <UserControl.CommandBindings>
        <CommandBinding Command="New" Executed="NuevaCompra_Click" />
    </UserControl.CommandBindings>

    <DockPanel>
        <!-- Encabezado. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,16">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <!-- + Nueva compra (HU-11, T-81): Alt+N. -->
            <Button DockPanel.Dock="Right" Style="{StaticResource BotonPrincipal}" Height="40" Padding="16,0"
                    Click="NuevaCompra_Click" ToolTip="Registrar la factura o boleta de un proveedor (Alt+N)."
                    Visibility="{Binding PuedeRegistrar, Converter={StaticResource BoolAVisible}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Nueva compra" />
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Compras a proveedores" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Las facturas y boletas de los proveedores, para controlar los egresos. Filtre por fecha del comprobante o por proveedor."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Filtros (HU-11, criterio 3): Enter busca. -->
        <Border DockPanel.Dock="Top" Margin="28,0,28,12" Padding="16,12" CornerRadius="6" Background="{StaticResource SuperficieAlterna}">
            <WrapPanel>
                <WrapPanel.Resources>
                    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Padding" Value="0,0,8,0" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                </WrapPanel.Resources>
                <WrapPanel.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding BuscarCommand}" />
                </WrapPanel.InputBindings>

                <Label Content="_Desde" Target="{Binding ElementName=CampoDesde}" />
                <DatePicker x:Name="CampoDesde" Width="135" Height="36" Margin="0,0,16,0" VerticalContentAlignment="Center"
                            SelectedDate="{Binding Desde}" SelectedDateFormat="Short" />
                <Label Content="_Hasta" Target="{Binding ElementName=CampoHasta}" />
                <DatePicker x:Name="CampoHasta" Width="135" Height="36" Margin="0,0,16,0" VerticalContentAlignment="Center"
                            SelectedDate="{Binding Hasta}" SelectedDateFormat="Short" />
                <Label Content="_Proveedor" Target="{Binding ElementName=CampoProveedor}" />
                <TextBox x:Name="CampoProveedor" Width="260" Height="36" Margin="0,0,12,0" VerticalContentAlignment="Center"
                         Text="{Binding Proveedor, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="RUC (o sus primeros dígitos) o parte de la razón social o del nombre comercial." />
                <Button Height="36" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource BotonPrincipal}" Command="{Binding BuscarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="_Buscar" />
                    </StackPanel>
                </Button>
                <Button Height="36" Padding="12,0" Margin="0,0,8,0" Content="Este _mes" Command="{Binding MesCommand}" />
                <Button Height="36" Padding="12,0" Content="T_odo" Command="{Binding LimpiarCommand}" />
            </WrapPanel>
        </Border>

        <!-- Total de egresos del período. -->
        <TextBlock DockPanel.Dock="Top" Margin="30,0,28,10" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource Acento}" Text="{Binding Resumen}"
                   Visibility="{Binding Resumen, Converter={StaticResource NuloAOculto}}" />

        <!-- Pie: mensaje y cerrar. -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextoSuave}" />
            </DockPanel>
        </Border>

        <Grid Margin="28,0,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- Compras, de la fecha más reciente a la más antigua. -->
            <Border Style="{StaticResource Tarjeta}">
                <DataGrid x:Name="Lista" ItemsSource="{Binding Compras}" SelectedItem="{Binding Seleccionada}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource Borde}" Background="Transparent" BorderThickness="0"
                          FontSize="14" RowHeight="38" FocusVisualStyle="{x:Null}"
                          ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                          RowStyle="{StaticResource FilaTabla}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaEmision, StringFormat='dd/MM/yyyy'}" Width="110" />
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor.RazonSocial}" Width="*" />
                        <DataGridTextColumn Header="RUC" Binding="{Binding Proveedor.Ruc}" Width="120" />
                        <DataGridTextColumn Header="Comprobante" Binding="{Binding DocumentoCompleto}" Width="200" />
                        <DataGridTextColumn Header="Registró" Binding="{Binding TerminalNombre}" Width="130" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='S/ {0:0.00}'}" Width="120"
                                            HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detalle de la compra elegida. -->
            <Border Grid.Row="2" Style="{StaticResource Tarjeta}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="16,10,16,4" FontWeight="SemiBold" TextWrapping="Wrap"
                               Visibility="{Binding Seleccionada, Converter={StaticResource NuloAOculto}}">
                        <Run Text="Detalle de la" /> <Run Text="{Binding Seleccionada.DocumentoCompleto, Mode=OneWay}" />
                        <Run Text="{Binding Seleccionada.Observacion, Mode=OneWay, StringFormat='· {0}'}" Foreground="{StaticResource TextoSuave}" FontWeight="Normal" />
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding Detalle}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                              HorizontalGridLinesBrush="{StaticResource Borde}" Background="Transparent" BorderThickness="0"
                              FontSize="13.5" RowHeight="34" FocusVisualStyle="{x:Null}"
                              ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                              RowStyle="{StaticResource FilaTabla}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N.°" Binding="{Binding Item}" Width="56"
                                                HeaderStyle="{StaticResource CabeceraNumero}" ElementStyle="{StaticResource Centrado}" />
                            <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*" />
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat='0.###'}" Width="100"
                                                HeaderStyle="{StaticResource CabeceraNumero}" ElementStyle="{StaticResource Centrado}" />
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="90"
                                                HeaderStyle="{StaticResource CabeceraNumero}" ElementStyle="{StaticResource Centrado}" />
                            <DataGridTextColumn Header="Costo unit." Binding="{Binding CostoUnitario, StringFormat='0.00##'}" Width="120"
                                                HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                            <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat='0.00'}" Width="120"
                                                HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
