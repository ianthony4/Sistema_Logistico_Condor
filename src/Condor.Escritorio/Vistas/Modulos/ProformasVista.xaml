<!-- Proformas (F7, HU-09, T-73) en el panel derecho de la ventana principal. -->
<UserControl x:Class="Condor.Escritorio.Vistas.Modulos.ProformasVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.InputBindings>
        <KeyBinding Key="F11" Command="{Binding ReimprimirCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Encabezado. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,16">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE7C3;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Proformas" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Busque por número, DNI, RUC o nombre del cliente. Convertir en venta lleva el detalle a la pantalla de venta sin reescribirlo."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" />
            </StackPanel>
        </DockPanel>

        <!-- Búsqueda: Enter busca; vacío lista todas. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,0,28,14">
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Height="40" Padding="16,0" Command="{Binding BuscarCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Buscar" />
                </StackPanel>
            </Button>
            <TextBox x:Name="CampoBuscar" FontSize="15" Height="40" VerticalContentAlignment="Center"
                     Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="PR01-4, el RUC de la constructora o parte de su nombre.">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding BuscarCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <!-- Acciones. -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="230" Margin="12,0,0,0" Style="{StaticResource BotonPrincipal}"
                            Command="{Binding ConvertirCommand}" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Lleva el detalle y el cliente de la proforma a Nueva venta (solo si está vigente y no se convirtió).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" Style="{StaticResource Icono}" FontSize="14" Margin="0,0,8,0" />
                            <AccessText Text="_Convertir en venta (Enter)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Left" Command="{Binding ReimprimirCommand}" Margin="0,0,16,0"
                        Visibility="{Binding PuedeReimprimir, Converter={StaticResource BoolAVisible}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE749;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="_Reimprimir (F11)" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextoSuave}" />
            </DockPanel>
        </Border>

        <!-- Lista: de la más reciente a la más antigua. -->
        <Border Style="{StaticResource Tarjeta}" Margin="28,0,28,20">
            <DataGrid x:Name="Lista" ItemsSource="{Binding Proformas}" SelectedItem="{Binding Seleccionada}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Borde}" Background="Transparent" BorderThickness="0"
                      FontSize="14" RowHeight="40" FocusVisualStyle="{x:Null}"
                      PreviewKeyDown="Lista_PreviewKeyDown" MouseDoubleClick="Lista_MouseDoubleClick"
                      ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                      RowStyle="{StaticResource FilaTabla}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Número" Binding="{Binding Proforma.NumeroCompleto}" Width="150" />
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Proforma.Fecha.LocalDateTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="160" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Proforma.Cliente.Nombre, FallbackValue='Sin cliente'}" Width="*" />
                    <DataGridTextColumn Header="Documento" Binding="{Binding Proforma.Cliente.NumeroDocumento, FallbackValue='-'}" Width="120" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Proforma.Total, StringFormat='S/ {0:0.00}'}" Width="110"
                                        HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                    <!-- Vigente, vencida o en qué comprobante se convirtió (HU-09, criterio 3). -->
                    <DataGridTemplateColumn Header="Estado" Width="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EstadoTexto}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Exito}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Estado}" Value="Vencida">
                                                    <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Estado}" Value="Convertida">
                                                    <Setter Property="Foreground" Value="{StaticResource TextoSuave}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
