<!-- Historial de ventas (F5, HU-18) en el panel derecho de la ventana principal. -->
<UserControl x:Class="Condor.Escritorio.Vistas.Modulos.HistorialVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.InputBindings>
        <KeyBinding Key="F11" Command="{Binding ReimprimirCommand}" />
        <KeyBinding Key="F5" Command="{Binding ActualizarCommand}" />
    </UserControl.InputBindings>

    <DockPanel>
        <!-- Encabezado. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,16">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE823;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Historial de ventas" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Filtre por fechas, tipo, cliente o número. Elija el comprobante y pulse Reimprimir (F11): sale marcado como copia. La columna SUNAT dice si ya fue aceptado; los pendientes se reenvían solos."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Filtros (HU-18, T-76): Enter en cualquier campo busca. -->
        <Border DockPanel.Dock="Top" Margin="28,0,28,12" Padding="16,12" CornerRadius="6" Background="{StaticResource SuperficieAlterna}">
            <StackPanel>
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0,0,8,0" />
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                    </WrapPanel.Resources>
                    <WrapPanel.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ActualizarCommand}" />
                    </WrapPanel.InputBindings>

                    <Label Content="_Desde" Target="{Binding ElementName=CampoDesde}" />
                    <DatePicker x:Name="CampoDesde" Width="135" Height="36" Margin="0,0,16,0" VerticalContentAlignment="Center"
                                SelectedDate="{Binding Desde}" SelectedDateFormat="Short" />
                    <Label Content="_Hasta" Target="{Binding ElementName=CampoHasta}" />
                    <DatePicker x:Name="CampoHasta" Width="135" Height="36" Margin="0,0,16,0" VerticalContentAlignment="Center"
                                SelectedDate="{Binding Hasta}" SelectedDateFormat="Short" />
                    <Label Content="_Tipo" Target="{Binding ElementName=CampoTipo}" />
                    <ComboBox x:Name="CampoTipo" Width="160" Height="36" Margin="0,0,16,0" VerticalContentAlignment="Center"
                              ItemsSource="{Binding OpcionesTipo}" SelectedItem="{Binding Tipo}" DisplayMemberPath="Nombre" />
                    <Label Content="_Cliente o número" Target="{Binding ElementName=CampoTexto}" />
                    <TextBox x:Name="CampoTexto" Width="230" Height="36" Margin="0,0,12,0" VerticalContentAlignment="Center"
                             Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="DNI o RUC (o sus primeros dígitos), parte del nombre, o el número: B001-12 o 12." />
                    <Button Height="36" Padding="14,0" Margin="0,0,8,0" Style="{StaticResource BotonPrincipal}" Command="{Binding ActualizarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                            <AccessText Text="_Buscar" />
                        </StackPanel>
                    </Button>
                    <Button Height="36" Padding="12,0" Margin="0,0,8,0" Content="H_oy" Command="{Binding HoyCommand}" />
                    <Button Height="36" Padding="12,0" Margin="0,0,8,0" Content="Este _mes" Command="{Binding MesCommand}" />
                    <Button Height="36" Padding="12,0" Content="T_odo" Command="{Binding LimpiarCommand}"
                            ToolTip="Quitar los filtros: todo el historial, del más reciente al más antiguo." />
                </WrapPanel>
                <TextBlock Style="{StaticResource TextoError}" Text="{Binding ErrorFiltro}" Margin="0,8,0,0"
                           Visibility="{Binding ErrorFiltro, Converter={StaticResource NuloAOculto}}" />
            </StackPanel>
        </Border>

        <!-- Cuántos y cuánto vendido en el período (HU-18, criterio 1). -->
        <TextBlock DockPanel.Dock="Top" Margin="30,0,28,10" FontSize="15" FontWeight="SemiBold"
                   Foreground="{StaticResource Acento}" Text="{Binding Resumen}"
                   Visibility="{Binding Resumen, Converter={StaticResource NuloAOculto}}" />

        <!-- Acciones. -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="190" Margin="12,0,0,0" IsDefault="True"
                            Style="{StaticResource BotonPrincipal}" Command="{Binding ReimprimirCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" Style="{StaticResource Icono}" FontSize="14" Margin="0,0,8,0" />
                            <AccessText Text="_Reimprimir (F11)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Left" Command="{Binding ActualizarCommand}" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="_Actualizar (F5)" />
                    </StackPanel>
                </Button>
                <!-- HU-17: reenviar ya los pendientes, sin esperar al reenvío automático. -->
                <Button DockPanel.Dock="Left" Command="{Binding ReenviarCommand}" Margin="0,0,16,0"
                        Visibility="{Binding PuedeReenviar, Converter={StaticResource BoolAVisible}}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Envía ahora a la SUNAT los comprobantes pendientes (también se reenvían solos cada pocos minutos).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="R_eenviar a la SUNAT" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextoSuave}" />
            </DockPanel>
        </Border>

        <!-- Lista: del más reciente al más antiguo. -->
        <Border Style="{StaticResource Tarjeta}" Margin="28,0,28,20">
            <DataGrid x:Name="Lista" ItemsSource="{Binding Comprobantes}" SelectedItem="{Binding Seleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Borde}" Background="Transparent" BorderThickness="0"
                      FontSize="14" RowHeight="40" FocusVisualStyle="{x:Null}" MouseDoubleClick="Lista_MouseDoubleClick"
                      ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                      RowStyle="{StaticResource FilaTabla}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoCorto}" Width="120" />
                    <DataGridTextColumn Header="Número" Binding="{Binding NumeroCompleto}" Width="150" />
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha.LocalDateTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="170" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.Nombre, FallbackValue='Clientes varios'}" Width="*" />
                    <DataGridTextColumn Header="Caja" Binding="{Binding TerminalNombre}" Width="150" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='S/ {0:0.00}'}" Width="110"
                                        HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                    <DataGridTemplateColumn Header="Impreso" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Impresiones, StringFormat='Sí ({0} veces)'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Impresiones}" Value="0">
                                                    <Setter Property="Text" Value="Sin imprimir" />
                                                    <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Impresiones}" Value="1">
                                                    <Setter Property="Text" Value="Sí" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- Estado ante la SUNAT (HU-07, T-48); el motivo sale al pasar el mouse. -->
                    <DataGridTemplateColumn Header="SUNAT" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center"
                                           ToolTip="{Binding MensajeSunat, TargetNullValue='Aún no se envió a la SUNAT.'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- El texto va en el estilo: si se pusiera en el TextBlock, los triggers no podrían cambiarlo. -->
                                            <Setter Property="Text" Value="{Binding EstadoSunat}" />
                                            <Setter Property="Foreground" Value="{StaticResource Acento}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstadoSunat}" Value="ACEPTADO">
                                                    <Setter Property="Text" Value="Aceptada" />
                                                    <Setter Property="Foreground" Value="{StaticResource Exito}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstadoSunat}" Value="OBSERVADO">
                                                    <Setter Property="Text" Value="Aceptada con obs." />
                                                    <Setter Property="Foreground" Value="{StaticResource Exito}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstadoSunat}" Value="RECHAZADO">
                                                    <Setter Property="Text" Value="Rechazada" />
                                                    <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstadoSunat}" Value="PENDIENTE">
                                                    <Setter Property="Text" Value="Pendiente" />
                                                </DataTrigger>
                                                <!-- Notas de venta y proformas no van a la SUNAT (HU-08, HU-09). Va al final para ganarle a PENDIENTE. -->
                                                <DataTrigger Binding="{Binding EsElectronico}" Value="False">
                                                    <Setter Property="Text" Value="No aplica" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextoTenue}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="ToolTip" Value="Documento interno: no se envía a la SUNAT." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
