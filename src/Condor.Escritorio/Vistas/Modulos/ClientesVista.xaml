<!-- Clientes (F3, T-97) en el panel derecho de la ventana principal. -->
<UserControl x:Class="Condor.Escritorio.Vistas.Modulos.ClientesVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Alt" Command="New" />
    </UserControl.InputBindings>

    <UserControl.CommandBindings>
        <CommandBinding Command="New" Executed="NuevoCliente_Click" />
    </UserControl.CommandBindings>

    <DockPanel>
        <!-- Encabezado. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,16">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE77B;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <Button DockPanel.Dock="Right" Style="{StaticResource BotonPrincipal}" Height="40" Padding="16,0"
                    Click="NuevoCliente_Click" ToolTip="Registrar un cliente con su DNI o RUC (Alt+N).">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Nuevo cliente" />
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Clientes" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Busque por DNI, RUC o nombre. Usar en la venta lo deja elegido en Nueva venta."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" />
            </StackPanel>
        </DockPanel>

        <!-- Búsqueda: Enter busca; vacío lista todos. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,0,28,14">
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Height="40" Padding="16,0" Command="{Binding BuscarCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Buscar" />
                </StackPanel>
            </Button>
            <TextBox x:Name="CampoBuscar" FontSize="15" Height="40" VerticalContentAlignment="Center"
                     Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding BuscarCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <!-- Pie. -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="190" Margin="12,0,0,0" Style="{StaticResource BotonPrincipal}" Command="{Binding UsarCommand}">
                        <AccessText Text="_Usar en la venta" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextoSuave}" />
            </DockPanel>
        </Border>

        <!-- Clientes, ordenados por nombre. -->
        <Border Style="{StaticResource Tarjeta}" Margin="28,0,28,20">
            <DataGrid x:Name="Lista" ItemsSource="{Binding Clientes}" SelectedItem="{Binding Seleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Borde}" Background="Transparent" BorderThickness="0"
                      FontSize="14" RowHeight="40" FocusVisualStyle="{x:Null}" MouseDoubleClick="Lista_MouseDoubleClick"
                      ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                      RowStyle="{StaticResource FilaTabla}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" Width="170" />
                    <DataGridTextColumn Header="Nombre o razón social" Binding="{Binding Nombre}" Width="*" />
                    <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
