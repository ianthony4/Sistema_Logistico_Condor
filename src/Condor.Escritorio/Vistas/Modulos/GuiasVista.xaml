<!-- Guías de remisión (F8, HU-10, T-94) en el panel derecho de la ventana principal. -->
<UserControl x:Class="Condor.Escritorio.Vistas.Modulos.GuiasVista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Alt" Command="New" />
        <KeyBinding Key="F11" Command="{Binding ReimprimirCommand}" />
    </UserControl.InputBindings>

    <UserControl.CommandBindings>
        <CommandBinding Command="New" Executed="NuevaGuia_Click" />
    </UserControl.CommandBindings>

    <DockPanel>
        <!-- Encabezado. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,16">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE806;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <Button DockPanel.Dock="Right" Style="{StaticResource BotonPrincipal}" Height="40" Padding="16,0"
                    Click="NuevaGuia_Click" ToolTip="Emitir la guía para trasladar mercadería (Alt+N).">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Nueva guía" />
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Guías de remisión" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="La guía acompaña a la mercadería que va a las obras. Se imprime y se envía a la SUNAT al emitirla."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- Filtros. -->
        <Border DockPanel.Dock="Top" Margin="28,0,28,12" Padding="16,12" CornerRadius="6" Background="{StaticResource SuperficieAlterna}">
            <WrapPanel>
                <WrapPanel.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding BuscarCommand}" />
                </WrapPanel.InputBindings>
                <Label Content="_Desde" Target="{Binding ElementName=CampoDesde}" VerticalAlignment="Center" Padding="0,0,8,0" />
                <DatePicker x:Name="CampoDesde" Width="135" Height="36" Margin="0,0,16,0" SelectedDate="{Binding Desde}" />
                <Label Content="_Hasta" Target="{Binding ElementName=CampoHasta}" VerticalAlignment="Center" Padding="0,0,8,0" />
                <DatePicker x:Name="CampoHasta" Width="135" Height="36" Margin="0,0,16,0" SelectedDate="{Binding Hasta}" />
                <Label Content="Destinatario o _número" Target="{Binding ElementName=CampoBuscar}" VerticalAlignment="Center" Padding="0,0,8,0" />
                <TextBox x:Name="CampoBuscar" Width="260" Height="36" Margin="0,0,12,0" VerticalContentAlignment="Center"
                         Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" />
                <Button Height="36" Padding="14,0" Style="{StaticResource BotonPrincipal}" Command="{Binding BuscarCommand}">
                    <AccessText Text="_Buscar" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- Pie. -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="180" Margin="12,0,0,0" Style="{StaticResource BotonPrincipal}" Command="{Binding ReimprimirCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" Style="{StaticResource Icono}" FontSize="14" Margin="0,0,8,0" />
                            <AccessText Text="_Reimprimir (F11)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Left" Margin="0,0,16,0" Command="{Binding EnviarPendientesCommand}"
                        Visibility="{Binding EnvioConfigurado, Converter={StaticResource BoolAVisible}}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Envía o consulta ahora las guías pendientes (también se hace solo cada pocos minutos).">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="_Enviar pendientes a la SUNAT" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextoSuave}" />
            </DockPanel>
        </Border>

        <!-- Guías, de la más reciente a la más antigua. -->
        <Border Style="{StaticResource Tarjeta}" Margin="28,0,28,20">
            <DataGrid x:Name="Lista" ItemsSource="{Binding Guias}" SelectedItem="{Binding Seleccionada}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Borde}" Background="Transparent" BorderThickness="0"
                      FontSize="14" RowHeight="40" FocusVisualStyle="{x:Null}"
                      ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                      RowStyle="{StaticResource FilaTabla}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Número" Binding="{Binding NumeroCompleto}" Width="150" />
                    <DataGridTextColumn Header="Traslado" Binding="{Binding FechaTraslado, StringFormat='dd/MM/yyyy'}" Width="110" />
                    <DataGridTextColumn Header="Destinatario" Binding="{Binding DestinatarioNombre}" Width="*" />
                    <DataGridTextColumn Header="Llegada" Binding="{Binding LlegadaDireccion}" Width="*" />
                    <DataGridTextColumn Header="Comprobante" Binding="{Binding ComprobanteNumero, TargetNullValue='—'}" Width="140" />
                    <DataGridTemplateColumn Header="SUNAT" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center"
                                           ToolTip="{Binding MensajeSunat, TargetNullValue='Aún no se envió a la SUNAT.'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Pendiente" />
                                            <Setter Property="Foreground" Value="{StaticResource Acento}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EstadoSunat}" Value="ACEPTADO">
                                                    <Setter Property="Text" Value="Aceptada" />
                                                    <Setter Property="Foreground" Value="{StaticResource Exito}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstadoSunat}" Value="OBSERVADO">
                                                    <Setter Property="Text" Value="Aceptada con obs." />
                                                    <Setter Property="Foreground" Value="{StaticResource Exito}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EstadoSunat}" Value="RECHAZADO">
                                                    <Setter Property="Text" Value="Rechazada" />
                                                    <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
