<Window x:Class="Condor.Escritorio.Vistas.ProveedoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proveedores"
        Width="1100" Height="640" MinWidth="880" MinHeight="440"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Superficie}"
        FocusManager.FocusedElement="{Binding ElementName=CampoBuscar}">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Alt" Command="New" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="NuevoProveedor_Click" />
    </Window.CommandBindings>

    <DockPanel>
        <!-- Encabezado. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,16">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE821;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <Button DockPanel.Dock="Right" Style="{StaticResource BotonPrincipal}" Height="40" Padding="16,0"
                    Click="NuevoProveedor_Click" ToolTip="Registrar un proveedor (Alt+N).">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Nuevo proveedor" />
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Proveedores" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Busque por RUC o por razón social. Los datos se comparten en las tres PC."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" />
            </StackPanel>
        </DockPanel>

        <!-- Búsqueda: Enter busca; vacío lista todos. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,0,28,14">
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Height="40" Padding="16,0" Command="{Binding BuscarCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="Buscar" />
                </StackPanel>
            </Button>
            <TextBox x:Name="CampoBuscar" FontSize="15" Height="40" VerticalContentAlignment="Center"
                     Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding BuscarCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>

        <!-- Pie: resultado y cerrar. -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cerrar" Width="120" IsCancel="True" Click="Cerrar_Click" />
                <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextoSuave}" />
            </DockPanel>
        </Border>

        <!-- Lista, ordenada por razón social. -->
        <Border Style="{StaticResource Tarjeta}" Margin="28,0,28,20">
            <DataGrid x:Name="Lista" ItemsSource="{Binding Proveedores}" SelectedItem="{Binding Seleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Borde}" Background="Transparent" BorderThickness="0"
                      FontSize="14" RowHeight="40" FocusVisualStyle="{x:Null}"
                      ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                      RowStyle="{StaticResource FilaTabla}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="RUC" Binding="{Binding Ruc}" Width="130" />
                    <DataGridTextColumn Header="Razón social" Binding="{Binding RazonSocial}" Width="2*" />
                    <DataGridTextColumn Header="Nombre comercial" Binding="{Binding NombreComercial}" Width="*" />
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120" />
                    <DataGridTextColumn Header="Contacto" Binding="{Binding Contacto}" Width="*" />
                    <DataGridTextColumn Header="Correo" Binding="{Binding Correo}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
