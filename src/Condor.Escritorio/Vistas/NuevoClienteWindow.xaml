<Window x:Class="Condor.Escritorio.Vistas.NuevoClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo cliente"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Superficie}"
        FocusManager.FocusedElement="{Binding ElementName=CampoNumero}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}" />
    </Window.InputBindings>

    <StackPanel>
        <!-- Encabezado. -->
        <DockPanel Margin="28,26,28,8">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE8FA;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Nuevo cliente" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Queda registrado en las tres PC y elegido en esta venta."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" />
            </StackPanel>
        </DockPanel>

        <!-- Formulario. -->
        <Grid Margin="28,16,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Content="Documento" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="D_NI" IsChecked="{Binding EsDni}" Margin="0,0,18,0" FontSize="15" VerticalContentAlignment="Center" />
                <RadioButton Content="R_UC" IsChecked="{Binding EsRuc}" FontSize="15" VerticalContentAlignment="Center" />
            </StackPanel>

            <Label Grid.Column="2" Content="Nú_mero" Target="{Binding ElementName=CampoNumero}" />
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="CampoNumero" FontSize="15" MaxLength="13"
                     Text="{Binding NumeroDocumento, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="3" Grid.ColumnSpan="3" Content="{Binding EtiquetaNombre}" Target="{Binding ElementName=CampoNombre}" />
            <TextBox Grid.Row="4" Grid.ColumnSpan="3" x:Name="CampoNombre" MaxLength="200" FontSize="15"
                     Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="6" Grid.ColumnSpan="3" Content="_Dirección (opcional)" Target="{Binding ElementName=CampoDireccion}" />
            <TextBox Grid.Row="7" Grid.ColumnSpan="3" x:Name="CampoDireccion" MaxLength="250" FontSize="15"
                     Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!-- Error de validación o de guardado (RUC inválido, documento repetido...). -->
        <Border Margin="28,16,28,0" Padding="12,10" CornerRadius="8" Background="{StaticResource ErrorSuave}"
                Visibility="{Binding Error, Converter={StaticResource NuloAOculto}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE783;" Style="{StaticResource Icono}" FontSize="14"
                           Foreground="{StaticResource Error}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource TextoError}" Margin="0" />
            </DockPanel>
        </Border>

        <!-- Acciones. -->
        <Border Margin="0,26,0,0" Padding="28,16" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="130" IsCancel="True" Command="{Binding CancelarCommand}" />
                <Button Width="150" Margin="12,0,0,0" IsDefault="True"
                        Style="{StaticResource BotonPrincipal}" Command="{Binding GuardarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="_Guardar" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
