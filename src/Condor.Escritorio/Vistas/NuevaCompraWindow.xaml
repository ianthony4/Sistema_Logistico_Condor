<Window x:Class="Condor.Escritorio.Vistas.NuevaCompraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva compra"
        Width="980" Height="760" MinWidth="860" MinHeight="620"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Superficie}"
        FocusManager.FocusedElement="{Binding ElementName=CampoRuc}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Encabezado. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,10">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE8A5;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Nueva compra" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Copie los datos del comprobante que entregó el proveedor. Los costos van con IGV."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" />
            </StackPanel>
        </DockPanel>

        <!-- Acciones. -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Width="130" IsCancel="True" Command="{Binding CancelarCommand}" />
                    <Button Width="170" Margin="12,0,0,0" Style="{StaticResource BotonPrincipal}" Command="{Binding GuardarCommand}"
                            ToolTip="Guarda la compra en la base central (Ctrl+G).">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                            <AccessText Text="_Guardar compra" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Totales: los costos incluyen IGV, como en la venta. -->
                <TextBlock VerticalAlignment="Center" FontSize="14">
                    <Run Text="Op. gravada" Foreground="{StaticResource TextoSuave}" />
                    <Run Text="{Binding OpGravada, Mode=OneWay, StringFormat='S/ {0:0.00}'}" />
                    <Run Text="   IGV" Foreground="{StaticResource TextoSuave}" />
                    <Run Text="{Binding Igv, Mode=OneWay, StringFormat='S/ {0:0.00}'}" />
                    <Run Text="   TOTAL" Foreground="{StaticResource Acento}" FontWeight="SemiBold" />
                    <Run Text="{Binding Total, Mode=OneWay, StringFormat='S/ {0:0.00}'}" Foreground="{StaticResource Acento}"
                         FontWeight="Bold" FontSize="18" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Error de validación o de guardado (comprobante repetido...). -->
        <Border DockPanel.Dock="Bottom" Margin="28,0,28,12" Padding="12,10" CornerRadius="8" Background="{StaticResource ErrorSuave}"
                Visibility="{Binding Error, Converter={StaticResource NuloAOculto}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE783;" Style="{StaticResource Icono}" FontSize="14"
                           Foreground="{StaticResource Error}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource TextoError}" Margin="0" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="28,8,28,0">
            <!-- Proveedor: RUC y Enter (o Buscar). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="_RUC del proveedor" Target="{Binding ElementName=CampoRuc}" />
                <TextBox Grid.Row="1" x:Name="CampoRuc" FontSize="15" MaxLength="60"
                         Text="{Binding DocumentoProveedor, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="RUC del proveedor (o parte de su razón social) y Enter.">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding BuscarProveedorCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Row="1" Grid.Column="2" Height="40" Padding="14,0" Command="{Binding BuscarProveedorCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="_Buscar" />
                    </StackPanel>
                </Button>
                <Border Grid.Row="1" Grid.Column="4" Padding="14,6" CornerRadius="5" Background="{StaticResource SuperficieAlterna}"
                        Visibility="{Binding Proveedor, Converter={StaticResource NuloAOculto}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Proveedor.RazonSocial}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Proveedor.Direccion}" FontSize="12.5" Foreground="{StaticResource TextoSuave}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Comprobante del proveedor. -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="Comprobante" />
                <UniformGrid Grid.Row="1" Columns="2">
                    <RadioButton Style="{StaticResource OpcionComprobante}" GroupName="TipoCompra" Content="Factura" IsChecked="{Binding EsFactura}" />
                    <RadioButton Style="{StaticResource OpcionComprobante}" GroupName="TipoCompra" Content="Boleta" IsChecked="{Binding EsBoleta}" />
                </UniformGrid>
                <Label Grid.Column="2" Content="_Serie" Target="{Binding ElementName=CampoSerie}" />
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="CampoSerie" FontSize="15" MaxLength="4" CharacterCasing="Upper"
                         Text="{Binding Serie, UpdateSourceTrigger=PropertyChanged}" ToolTip="F001, E001, FA01..." />
                <Label Grid.Column="4" Content="_Número" Target="{Binding ElementName=CampoNumero}" />
                <TextBox Grid.Row="1" Grid.Column="4" x:Name="CampoNumero" FontSize="15" MaxLength="8"
                         Text="{Binding NumeroTexto, UpdateSourceTrigger=PropertyChanged}" />
                <Label Grid.Column="6" Content="_Fecha" Target="{Binding ElementName=CampoFecha}" />
                <DatePicker Grid.Row="1" Grid.Column="6" x:Name="CampoFecha" Height="40" VerticalContentAlignment="Center"
                            SelectedDate="{Binding Fecha}" SelectedDateFormat="Short" />
            </Grid>

            <!-- Producto, cantidad y costo; Enter pasa de un campo al siguiente y agrega. -->
            <Grid Margin="0,14,0,0" Panel.ZIndex="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="_Producto" Target="{Binding ElementName=CampoProducto}" />
                <Grid Grid.Row="1" DataContext="{Binding Buscador}">
                    <TextBox x:Name="CampoProducto" FontSize="15" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CampoProducto_PreviewKeyDown" ToolTip="Escriba 3 letras o más del nombre del producto." />
                    <Popup IsOpen="{Binding MostrarSugerencias, Mode=OneWay}" PlacementTarget="{Binding ElementName=CampoProducto}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Padding="0,4" CornerRadius="5" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}"
                                BorderThickness="1" Effect="{StaticResource SombraFuerte}" Width="{Binding ActualWidth, ElementName=CampoProducto}">
                            <ListBox x:Name="ListaSugerencias" MaxHeight="280" ItemsSource="{Binding Sugerencias}" SelectedItem="{Binding Seleccionado}"
                                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                     ItemContainerStyle="{StaticResource ItemSugerencia}"
                                     PreviewKeyDown="ListaSugerencias_PreviewKeyDown" MouseDoubleClick="ListaSugerencias_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Nombre, Mode=OneWay}" /><Run Text="   ·   " Foreground="{StaticResource TextoSuave}" /><Run Text="{Binding Unidad, Mode=OneWay}" Foreground="{StaticResource TextoSuave}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                <Label Grid.Column="2" Content="C_antidad" Target="{Binding ElementName=CampoCantidad}" />
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="CampoCantidad" FontSize="15"
                         Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="CampoCantidad_PreviewKeyDown" />
                <Label Grid.Column="4" Content="_Costo unit. S/" Target="{Binding ElementName=CampoCosto}" />
                <TextBox Grid.Row="1" Grid.Column="4" x:Name="CampoCosto" FontSize="15"
                         Text="{Binding CostoTexto, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="CampoCosto_PreviewKeyDown"
                         ToolTip="Costo por unidad con IGV." />
                <Button Grid.Row="1" Grid.Column="6" Height="40" Padding="14,0" Style="{StaticResource BotonPrincipal}"
                        Command="{Binding AgregarCommand}" Click="Agregar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icono}" FontSize="12" Margin="0,0,8,0" />
                        <AccessText Text="Agr_egar" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Observación y detalle. -->
        <DockPanel Margin="28,14,28,12">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Label DockPanel.Dock="Left" Content="_Observación" Target="{Binding ElementName=CampoObservacion}" VerticalAlignment="Center"
                       Padding="0,0,12,0" />
                <TextBox x:Name="CampoObservacion" FontSize="14" MaxLength="250" Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Opcional: pedido de la obra, forma de pago..." />
            </DockPanel>
            <Border Style="{StaticResource Tarjeta}">
                <DataGrid ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                          HorizontalGridLinesBrush="{StaticResource Borde}" Background="Transparent" BorderThickness="0"
                          FontSize="14" RowHeight="40" FocusVisualStyle="{x:Null}"
                          ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                          RowStyle="{StaticResource FilaTabla}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N.°" Binding="{Binding Item}" Width="56"
                                            HeaderStyle="{StaticResource CabeceraNumero}" ElementStyle="{StaticResource Centrado}" />
                        <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*" />
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat='0.###'}" Width="100"
                                            HeaderStyle="{StaticResource CabeceraNumero}" ElementStyle="{StaticResource Centrado}" />
                        <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="90"
                                            HeaderStyle="{StaticResource CabeceraNumero}" ElementStyle="{StaticResource Centrado}" />
                        <DataGridTextColumn Header="Costo unit." Binding="{Binding CostoUnitario, StringFormat='0.00##'}" Width="120"
                                            HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                        <DataGridTextColumn Header="Importe" Binding="{Binding Importe, Mode=OneWay, StringFormat='0.00'}" Width="120"
                                            HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BotonQuitar}" HorizontalAlignment="Center"
                                            Command="{Binding DataContext.QuitarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
