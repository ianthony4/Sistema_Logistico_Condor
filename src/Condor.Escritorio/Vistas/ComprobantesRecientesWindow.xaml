<Window x:Class="Condor.Escritorio.Vistas.ComprobantesRecientesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Últimos comprobantes"
        Width="1040" Height="600" MinWidth="860" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Superficie}"
        FocusManager.FocusedElement="{Binding ElementName=Lista}">

    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{Binding ReimprimirCommand}" />
        <KeyBinding Key="F5" Command="{Binding ActualizarCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Encabezado. -->
        <DockPanel DockPanel.Dock="Top" Margin="28,24,28,16">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE823;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Últimos comprobantes" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Elija el comprobante y pulse Reimprimir (F11). Los que no salieron dicen «Sin imprimir»."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" />
            </StackPanel>
        </DockPanel>

        <!-- Acciones. -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cerrar" Width="120" IsCancel="True" Click="Cerrar_Click" />
                    <Button Width="190" Margin="12,0,0,0" IsDefault="True"
                            Style="{StaticResource BotonPrincipal}" Command="{Binding ReimprimirCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" Style="{StaticResource Icono}" FontSize="14" Margin="0,0,8,0" />
                            <AccessText Text="_Reimprimir (F11)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button DockPanel.Dock="Left" Command="{Binding ActualizarCommand}" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="_Actualizar (F5)" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Mensaje}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextoSuave}" />
            </DockPanel>
        </Border>

        <!-- Lista: del más reciente al más antiguo. -->
        <Border Style="{StaticResource Tarjeta}" Margin="28,0,28,20">
            <DataGrid x:Name="Lista" ItemsSource="{Binding Comprobantes}" SelectedItem="{Binding Seleccionado}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Borde}" Background="Transparent" BorderThickness="0"
                      FontSize="14" RowHeight="40" FocusVisualStyle="{x:Null}" MouseDoubleClick="Lista_MouseDoubleClick"
                      ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                      RowStyle="{StaticResource FilaTabla}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Número" Binding="{Binding NumeroCompleto}" Width="150" />
                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha.LocalDateTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="170" />
                    <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente.Nombre, FallbackValue='Clientes varios'}" Width="*" />
                    <DataGridTextColumn Header="Caja" Binding="{Binding TerminalNombre}" Width="150" />
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='S/ {0:0.00}'}" Width="110"
                                        HeaderStyle="{StaticResource CabeceraDerecha}" ElementStyle="{StaticResource NumeroDerecha}" />
                    <DataGridTemplateColumn Header="Impreso" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Impresiones, StringFormat='Sí ({0} veces)'}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Impresiones}" Value="0">
                                                    <Setter Property="Text" Value="Sin imprimir" />
                                                    <Setter Property="Foreground" Value="{StaticResource Error}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Impresiones}" Value="1">
                                                    <Setter Property="Text" Value="Sí" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
