<Window x:Class="Condor.Escritorio.Vistas.NuevaGuiaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva guía de remisión"
        Width="1040" Height="860" MinWidth="900" MinHeight="680"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Superficie}"
        FocusManager.FocusedElement="{Binding ElementName=CampoComprobante}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="Rotulo" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Seccion" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{StaticResource Acento}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Acciones. -->
        <Border DockPanel.Dock="Bottom" Padding="28,14" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Width="130" IsCancel="True" Command="{Binding CancelarCommand}" />
                    <Button Width="220" Margin="12,0,0,0" Style="{StaticResource BotonPrincipal}" Command="{Binding EmitirCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" Style="{StaticResource Icono}" FontSize="14" Margin="0,0,8,0" />
                            <AccessText Text="_Emitir, imprimir y enviar" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="{Binding Aviso}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextoSuave}" />
            </DockPanel>
        </Border>

        <!-- Por qué no se emitió. -->
        <Border DockPanel.Dock="Bottom" Margin="28,0,28,10" Padding="12,10" CornerRadius="8" Background="{StaticResource ErrorSuave}"
                Visibility="{Binding Error, Converter={StaticResource NuloAOculto}}">
            <TextBlock Text="{Binding Error}" Style="{StaticResource TextoError}" Margin="0" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,10">
                <TextBlock Text="Nueva guía de remisión" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Traiga los datos de la factura o boleta, o llénelos a mano. Serie T001."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" />

                <!-- Desde un comprobante. -->
                <DockPanel Margin="0,14,0,0">
                    <Label DockPanel.Dock="Left" Content="_Factura o boleta" Target="{Binding ElementName=CampoComprobante}"
                           VerticalAlignment="Center" Padding="0,0,12,0" />
                    <Button DockPanel.Dock="Left" Height="38" Padding="14,0" Margin="10,0,0,0" Command="{Binding TraerComprobanteCommand}">
                        <AccessText Text="_Traer datos" />
                    </Button>
                    <TextBox x:Name="CampoComprobante" Width="200" Height="38" HorizontalAlignment="Left" FontSize="15"
                             Text="{Binding ComprobanteTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="F001-31 o B001-120 y Enter.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding TraerComprobanteCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <!-- Destinatario y traslado. -->
                <TextBlock Text="Destinatario y traslado" Style="{StaticResource Seccion}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_DNI o RUC" Style="{StaticResource Rotulo}" Target="{Binding ElementName=CampoDestinatario}" />
                    <TextBox Grid.Row="1" x:Name="CampoDestinatario" Height="38" FontSize="15" MaxLength="13"
                             Text="{Binding DocumentoDestinatario, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding BuscarDestinatarioCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Row="1" Grid.Column="1" Height="38" Padding="12,0" Margin="8,0,0,0" Content="Buscar"
                            Command="{Binding BuscarDestinatarioCommand}" />
                    <Label Grid.Column="3" Content="Nombre o razón _social" Style="{StaticResource Rotulo}" Target="{Binding ElementName=CampoNombre}" />
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="CampoNombre" Height="38" FontSize="15" MaxLength="200"
                             Text="{Binding NombreDestinatario, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_Motivo" Style="{StaticResource Rotulo}" Target="{Binding ElementName=CampoMotivo}" />
                    <ComboBox Grid.Row="1" x:Name="CampoMotivo" Height="38" FontSize="14" VerticalContentAlignment="Center"
                              ItemsSource="{Binding OpcionesMotivo}" SelectedItem="{Binding Motivo}" DisplayMemberPath="Nombre" />
                    <Label Grid.Column="2" Content="Inicio del t_raslado" Style="{StaticResource Rotulo}" Target="{Binding ElementName=CampoFecha}" />
                    <DatePicker Grid.Row="1" Grid.Column="2" x:Name="CampoFecha" Height="38" SelectedDate="{Binding FechaTraslado}" />
                    <Label Grid.Column="4" Content="_Peso bruto (kg)" Style="{StaticResource Rotulo}" Target="{Binding ElementName=CampoPeso}" />
                    <TextBox Grid.Row="1" Grid.Column="4" x:Name="CampoPeso" Height="38" FontSize="15" TextAlignment="Right"
                             Text="{Binding PesoTexto, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Column="6" Content="Descripción del motivo" Style="{StaticResource Rotulo}"
                           Visibility="{Binding PideDescripcionMotivo, Converter={StaticResource BoolAVisible}}" />
                    <TextBox Grid.Row="1" Grid.Column="6" Height="38" FontSize="15" MaxLength="100"
                             Visibility="{Binding PideDescripcionMotivo, Converter={StaticResource BoolAVisible}}"
                             Text="{Binding DescripcionMotivo, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Puntos de partida y llegada. -->
                <TextBlock Text="Partida y llegada (ubigeo INEI de 6 dígitos: 040520 es Majes)" Style="{StaticResource Seccion}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="Ubigeo" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Row="1" Height="38" FontSize="15" MaxLength="6" Text="{Binding PartidaUbigeo, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Column="2" Content="Punto de partida" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Height="38" FontSize="15" MaxLength="250"
                             Text="{Binding PartidaDireccion, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="3" Content="_Ubigeo" Style="{StaticResource Rotulo}" Target="{Binding ElementName=CampoUbigeoLlegada}" />
                    <TextBox Grid.Row="4" x:Name="CampoUbigeoLlegada" Height="38" FontSize="15" MaxLength="6"
                             Text="{Binding LlegadaUbigeo, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="3" Grid.Column="2" Content="Punto de _llegada (la obra)" Style="{StaticResource Rotulo}"
                           Target="{Binding ElementName=CampoLlegada}" />
                    <TextBox Grid.Row="4" Grid.Column="2" x:Name="CampoLlegada" Height="38" FontSize="15" MaxLength="250"
                             Text="{Binding LlegadaDireccion, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Transporte. -->
                <TextBlock Text="Transporte" Style="{StaticResource Seccion}" />
                <UniformGrid Columns="2" Width="420" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource OpcionComprobante}" GroupName="Modalidad" Content="Privado (vehículo del local)"
                                 IsChecked="{Binding EsPrivado}" />
                    <RadioButton Style="{StaticResource OpcionComprobante}" GroupName="Modalidad" Content="Público (transportista)"
                                 IsChecked="{Binding EsPublico}" />
                </UniformGrid>
                <Grid Visibility="{Binding EsPrivado, Converter={StaticResource BoolAVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="Placa" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Row="1" Height="38" FontSize="15" MaxLength="8" CharacterCasing="Upper" Text="{Binding Placa, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Column="2" Content="DNI conductor" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Height="38" FontSize="15" MaxLength="8" Text="{Binding ConductorDni, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Column="4" Content="Nombres" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Height="38" FontSize="15" MaxLength="100" Text="{Binding ConductorNombres, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Column="6" Content="Apellidos" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Row="1" Grid.Column="6" Height="38" FontSize="15" MaxLength="100" Text="{Binding ConductorApellidos, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Column="8" Content="Licencia" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Row="1" Grid.Column="8" Height="38" FontSize="15" MaxLength="10" CharacterCasing="Upper" Text="{Binding ConductorLicencia, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Visibility="{Binding EsPublico, Converter={StaticResource BoolAVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="RUC del transportista" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Row="1" Height="38" FontSize="15" MaxLength="11" Text="{Binding TransportistaRuc, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Column="2" Content="Razón social del transportista" Style="{StaticResource Rotulo}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Height="38" FontSize="15" MaxLength="200" Text="{Binding TransportistaRazonSocial, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- Bienes. -->
                <TextBlock Text="Bienes que se trasladan" Style="{StaticResource Seccion}" />
                <Grid Panel.ZIndex="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid DataContext="{Binding Buscador}">
                        <TextBox x:Name="CampoProducto" Height="38" FontSize="15" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="CampoProducto_PreviewKeyDown" ToolTip="Escriba 3 letras o más del producto." />
                        <Popup IsOpen="{Binding MostrarSugerencias, Mode=OneWay}" PlacementTarget="{Binding ElementName=CampoProducto}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                            <Border Padding="0,4" CornerRadius="5" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Borde}"
                                    BorderThickness="1" Effect="{StaticResource SombraFuerte}" Width="{Binding ActualWidth, ElementName=CampoProducto}">
                                <ListBox MaxHeight="240" ItemsSource="{Binding Sugerencias}" SelectedItem="{Binding Seleccionado}"
                                         BorderThickness="0" Background="Transparent" DisplayMemberPath="Nombre"
                                         ItemContainerStyle="{StaticResource ItemSugerencia}" MouseDoubleClick="Sugerencias_MouseDoubleClick" />
                            </Border>
                        </Popup>
                    </Grid>
                    <TextBox Grid.Column="2" x:Name="CampoCantidad" Height="38" FontSize="15" TextAlignment="Right"
                             Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AgregarCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="4" Height="38" Padding="14,0" Style="{StaticResource BotonPrincipal}" Command="{Binding AgregarCommand}">
                        <AccessText Text="Agre_gar" />
                    </Button>
                </Grid>
                <Border Style="{StaticResource Tarjeta}" Margin="0,10,0,0" MinHeight="140">
                    <DataGrid ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Borde}"
                              Background="Transparent" BorderThickness="0" FontSize="14" RowHeight="36"
                              ColumnHeaderStyle="{StaticResource CabeceraTabla}" CellStyle="{StaticResource CeldaTabla}"
                              RowStyle="{StaticResource FilaTabla}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N.°" Binding="{Binding Item}" Width="56" />
                            <DataGridTextColumn Header="Producto" Binding="{Binding Descripcion}" Width="*" />
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat='0.###'}" Width="100" />
                            <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" Width="90" />
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BotonQuitar}" HorizontalAlignment="Center"
                                                Command="{Binding DataContext.QuitarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Label Content="_Observación (opcional)" Style="{StaticResource Rotulo}" Target="{Binding ElementName=CampoObservacion}" Margin="0,10,0,0" />
                <TextBox x:Name="CampoObservacion" Height="38" FontSize="14" MaxLength="250"
                         Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
