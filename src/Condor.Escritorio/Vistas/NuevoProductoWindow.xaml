<Window x:Class="Condor.Escritorio.Vistas.NuevoProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Condor.Presentacion.ViewModels;assembly=Condor.Presentacion"
        Title="Nuevo producto"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=CampoNombre}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}" />
    </Window.InputBindings>

    <StackPanel>
        <Border Background="{StaticResource FondoCabecera}" BorderBrush="{StaticResource Borde}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <TextBlock Text="Nuevo producto" FontWeight="Bold" FontSize="16" />
        </Border>

        <Grid Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="_Nombre:" Target="{Binding ElementName=CampoNombre}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CampoNombre" MaxLength="150"
                     Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="1" Content="_Precio S/.:" Target="{Binding ElementName=CampoPrecio}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CampoPrecio" Width="140" HorizontalAlignment="Left"
                     TextAlignment="Right"
                     Text="{Binding PrecioTexto, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="2" Content="_Unidad:" Target="{Binding ElementName=CampoUnidad}" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CampoUnidad" Width="140" Margin="4"
                      HorizontalAlignment="Left" IsEditable="True"
                      ItemsSource="{x:Static vm:NuevoProductoViewModel.Unidades}"
                      Text="{Binding Unidad, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="3" Content="Código barras:" />
            <TextBox Grid.Row="3" Grid.Column="1" IsEnabled="False" Text="(opcional, futuro)"
                     ToolTip="Se habilitará cuando se compre el lector (HU-13)." />
        </Grid>

        <TextBlock Margin="16,0" Style="{StaticResource TextoError}" Text="{Binding Error}">
            <TextBlock.Visibility>
                <Binding Path="Error" Converter="{StaticResource NuloAOculto}" />
            </TextBlock.Visibility>
        </TextBlock>

        <Grid Margin="16,8,16,16">
            <Button Content="Cancelar" HorizontalAlignment="Left" Width="150" IsCancel="True"
                    Command="{Binding CancelarCommand}" />
            <Button Content="_Guardar" HorizontalAlignment="Right" Width="150" IsDefault="True"
                    Style="{StaticResource BotonPrincipal}" Command="{Binding GuardarCommand}" />
        </Grid>
    </StackPanel>
</Window>
