<Window x:Class="Condor.Escritorio.Vistas.NuevoProveedorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo proveedor"
        Width="620" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Superficie}"
        FocusManager.FocusedElement="{Binding ElementName=CampoRuc}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelarCommand}" />
    </Window.InputBindings>

    <StackPanel>
        <!-- Encabezado. -->
        <DockPanel Margin="28,26,28,8">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="{StaticResource AcentoSuave}"
                    Margin="0,0,14,0">
                <TextBlock Text="&#xE821;" Style="{StaticResource Icono}" FontSize="20" Foreground="{StaticResource Acento}"
                           HorizontalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Nuevo proveedor" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="Queda registrado en las tres PC para asociarlo a las compras."
                           Foreground="{StaticResource TextoSuave}" FontSize="13" />
            </StackPanel>
        </DockPanel>

        <!-- Formulario: RUC y razón social obligatorios; lo demás, opcional. -->
        <Grid Margin="28,16,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Content="_RUC" Target="{Binding ElementName=CampoRuc}" />
            <TextBox Grid.Row="1" x:Name="CampoRuc" FontSize="15" MaxLength="13"
                     Text="{Binding Ruc, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Column="2" Content="Ra_zón social" Target="{Binding ElementName=CampoRazonSocial}" />
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="CampoRazonSocial" FontSize="15" MaxLength="200"
                     Text="{Binding RazonSocial, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="3" Grid.ColumnSpan="3" Content="Nombre _comercial (opcional)" Target="{Binding ElementName=CampoComercial}" />
            <TextBox Grid.Row="4" Grid.ColumnSpan="3" x:Name="CampoComercial" FontSize="15" MaxLength="150"
                     Text="{Binding NombreComercial, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="6" Grid.ColumnSpan="3" Content="_Dirección (opcional)" Target="{Binding ElementName=CampoDireccion}" />
            <TextBox Grid.Row="7" Grid.ColumnSpan="3" x:Name="CampoDireccion" FontSize="15" MaxLength="250"
                     Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="9" Content="_Teléfono" Target="{Binding ElementName=CampoTelefono}" />
            <TextBox Grid.Row="10" x:Name="CampoTelefono" FontSize="15" MaxLength="30"
                     Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Grid.Row="9" Grid.RowSpan="2" Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="C_orreo" Target="{Binding ElementName=CampoCorreo}" />
                <TextBox Grid.Row="1" x:Name="CampoCorreo" FontSize="15" MaxLength="120"
                         Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}" />
                <Label Grid.Column="2" Content="Co_ntacto" Target="{Binding ElementName=CampoContacto}" />
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="CampoContacto" FontSize="15" MaxLength="120"
                         Text="{Binding Contacto, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Persona que atiende los pedidos." />
            </Grid>
        </Grid>

        <!-- Error de validación o de guardado (RUC inválido, RUC repetido...). -->
        <Border Margin="28,16,28,0" Padding="12,10" CornerRadius="8" Background="{StaticResource ErrorSuave}"
                Visibility="{Binding Error, Converter={StaticResource NuloAOculto}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE783;" Style="{StaticResource Icono}" FontSize="14"
                           Foreground="{StaticResource Error}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource TextoError}" Margin="0" />
            </DockPanel>
        </Border>

        <!-- Acciones. -->
        <Border Margin="0,26,0,0" Padding="28,16" Background="{StaticResource SuperficieAlterna}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="130" IsCancel="True" Command="{Binding CancelarCommand}" />
                <Button Width="150" Margin="12,0,0,0" IsDefault="True"
                        Style="{StaticResource BotonPrincipal}" Command="{Binding GuardarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icono}" FontSize="13" Margin="0,0,8,0" />
                        <AccessText Text="_Guardar" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
