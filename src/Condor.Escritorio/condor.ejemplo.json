{
  // Copie este archivo como condor.json en la carpeta del programa de cada PC.
  // En la PC principal use "localhost"; en las demás, la IP fija de la PC principal.
  "Servidor": "192.168.1.10",
  "Puerto": 5432,
  "BaseDatos": "condor",
  "Usuario": "condor_app",
  "Clave": "",
  "TiempoEsperaSegundos": 5,

  // Ticketera térmica de 80 mm (HU-12). "Nombre" es el de la impresora en
  // Configuración > Impresoras de Windows. Si se deja vacío, el ticket se
  // muestra en pantalla en lugar de imprimirse.
  "Ticketera": {
    "Nombre": "",
    "Columnas": 48,
    "EsperaSegundos": 10
  },

  // Envío a la SUNAT (HU-07). Solo en la PC que tiene internet; las demás
  // pueden dejarlo vacío y sus comprobantes quedan pendientes de envío.
  // Ambiente "Beta" (pruebas): usuario MODDATOS, clave moddatos y, si no se
  // indica certificado, se firma con uno de prueba. En "Produccion" van el
  // usuario secundario SOL de la ferretería y su certificado digital (.pfx).
  "Sunat": {
    "Ambiente": "Beta",
    "UsuarioSol": "MODDATOS",
    "ClaveSol": "moddatos",
    "Certificado": "",
    "ClaveCertificado": "",
    "EsperaSegundos": 30
  }
}
